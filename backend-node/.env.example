PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/deepguard

# Supabase (get from supabase.com — free tier)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# AI Engine
# AI_ENGINE_URL=http://localhost:8000
# on windows
AI_ENGINE_URL=http://127.0.0.1:8000

# Frontend
FRONTEND_URL=http://localhost:5173

# ── FREE AI for Report Generation (choose one or more) ──

# Option 1: Groq — FREE, fast, no credit card needed
# Get key at: https://console.groq.com (completely free)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Ollama — 100% LOCAL, completely free
# Install from: https://ollama.ai then run: ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Option 3: OpenAI — PAID (optional, not needed)
# OPENAI_API_KEY=sk-...
